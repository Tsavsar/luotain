generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?

  // Seed for the generated gradient avatar, used whenever `image` is null
  // — which is the default, and what someone falls back to after deleting
  // an uploaded photo.
  //
  // A seed rather than a rendered image: the gradient is derived from this
  // string at render time, so there's no file to store, no CDN, nothing to
  // break, and it draws instantly. Re-rolling is just writing a new value.
  //
  // Nullable, and null falls back to the record's id — so every existing
  // user has a stable avatar with no backfill, and this is only written
  // once someone deliberately re-rolls.
  avatarSeed String?

  // Powers "Last updated" on the account settings page. An explicit
  // column rather than Prisma's @updatedAt, because @updatedAt fires on
  // ANY write to this row — a session refresh or an emailVerified change
  // would bump it, and the settings page would then claim the profile was
  // edited when nothing on that page changed. This is set only by the
  // handler that saves those fields, so it means exactly what the label
  // says. Null = never edited.
  profileUpdatedAt DateTime?
  accounts      Account[]
  sessions      Session[]
  // The app's own sessions — see AppSession. Separate from `sessions` above,
  // which is NextAuth's and only covers OAuth.
  appSessions   AppSession[]
  memberships   Membership[]
  links         Link[] // links this user created — org owns them, this is attribution only
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  // When the provider was linked. NextAuth's own schema doesn't include
  // this, but the connected-accounts screen shows "Connected 12th August,
  // 2025" — without it that line can only be invented.
  //
  // Defaulted to now() so existing rows get a value rather than being
  // excluded, though for accounts linked before this column existed the
  // date is the migration date, not the real one. Honest about that below.
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth's own session table, left exactly as NextAuth expects it.
//
// Rows land here for OAuth sign-ins via PrismaAdapter, but the app does NOT
// authenticate off them — see AppSession below, which is what actually
// decides who's signed in. Adding device columns here was a mistake on my
// part: email-code sign-ins never create a row, so it could only ever have
// described half the sessions.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── AppSession ───
// The app's real session, and the thing the sessions screen lists.
//
// Both sign-in paths (email code and OAuth) end at setAppSession(), which
// issues a JWT in the `app-session` cookie. That token used to be entirely
// self-contained, which meant two things: sessions couldn't be listed,
// because nothing recorded them; and they couldn't be revoked, because a
// signed JWT stays valid until it expires no matter what you delete.
//
// This table is what fixes both. Each token carries a `jti` matching a row
// here, and getCurrentUserEmail() checks the row still exists as well as
// verifying the signature — so deleting a row genuinely ends that session.
//
// The cost is one database read per authenticated request. That's the real
// price of revocable sessions; a JWT you can't revoke isn't a session, it's
// a bearer token with an expiry date.
model AppSession {
  id  String @id @default(cuid())
  // The JWT's `jti` claim. Unique, so a token can only ever match one row.
  jti String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The raw user-agent rather than a parsed device name: parsing rules go
  // stale as browsers change, so keeping the original means a session
  // recorded today can be re-parsed by better rules later.
  userAgent String?
  // Coarse location, resolved from the request at sign-in. Text rather than
  // coordinates — the screen shows "Lagos, Nigeria" and nothing needs more
  // than that.
  city    String?
  country String?
  // Deliberately NO ip column. It's the most identifying part of the
  // request, the screen never displays it, and the city and country are
  // resolved at sign-in — so there's no reason to keep it.

  // Drives "Active now" vs "Last active 2 hours ago". Written at most once
  // every few minutes rather than on every request, or this would be a
  // database write per page load.
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  // Mirrors the token's own expiry, so expired sessions can be filtered out
  // and cleaned up without having to decode every token.
  expiresAt    DateTime

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id        String       @id @default(cuid())
  name      String
  // An org's logo, once uploads exist. Null today for every org.
  image     String?
  // Same gradient treatment as User — an org without a logo gets one
  // derived from its own id rather than a grey square.
  avatarSeed String?
  createdAt DateTime     @default(now())
  members   Membership[]
  links     Link[]
  clicks    Click[]
  // Custom domains belonging to this org. Prisma requires this side of
  // the relation to exist even though nothing reads it yet.
  domains   Domain[]
}

model Membership {
  id             String       @id @default(cuid())
  role           Role         @default(OWNER)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

// ─── Domain ───
// Added because the create form can now pick a domain, and that breaks
// the old assumption that one shortCode means one link. `verified` backs
// the form's own promise ("Only verified domains show up here").
//
// organizationId null = a shared domain every org can use (luot.link
// itself). Non-null = an org's own custom domain, visible only to them.
model Domain {
  id       String  @id @default(cuid())
  hostname String  @unique // "luot.link", "go.acme.com"
  verified Boolean @default(false)

  // Null for the shared default. Cascade so deleting an org takes its
  // custom domains with it — a domain with no owner and no shared flag
  // would be unreachable.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  links   Link[]
  qrCodes QrCode[]

  createdAt DateTime @default(now())

  @@index([organizationId])
}

model Link {
  id             String   @id @default(cuid())
  // NOT globally unique any more. With more than one domain in play,
  // luot.link/summer and go.acme.com/summer are different links, and a
  // global constraint would have the first one block the second. The
  // compound @@unique([domainId, shortCode]) below is what replaces it.
  shortCode      String
  destinationUrl String
  title          String?

  // Scraped from the destination's Open Graph tags, for the preview on
  // the link detail page. Nullable because plenty of URLs have no OG
  // image, some hosts refuse server-side fetches, and some time out —
  // the UI already falls back to the logo mark when this is null.
  ogImageUrl     String?

  domainId String
  domain   Domain @relation(fields: [domainId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  qrCodes QrCode[]
  clicks  Click[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Soft delete. Null = active/live link. Set on delete, cleared
  // back to null on recover — the trash page is just "where
  // deletedAt is not null" and the real links list adds "is null" to
  // whatever it already filters by. Permanent removal after the
  // 30-day window is a separate concern (a scheduled job doing a
  // real .delete(), not anything this field triggers by itself) —
  // not implemented here, since nothing user-facing needs it yet.
  deletedAt DateTime?

  // A slug only has to be unique within its own domain.
  @@unique([domainId, shortCode])
  @@index([organizationId])
  // Compound, not just organizationId alone — every query that reads
  // this table from now on filters by both together (trash: is not
  // null, real list: is null), so the index should match the shape
  // of the actual queries rather than just the column that already
  // had one.
  @@index([organizationId, deletedAt])
}

model QrCode {
  id        String @id @default(cuid())
  // Its own slug, distinct from the parent link's — lets a scan be
  // attributed to this specific QR placement (e.g. "Store window" vs
  // "Business card") rather than the link generally.
  //
  // Same de-globalising as Link.shortCode, and for the same reason.
  //
  // WORTH KNOWING: a QR's slug and a link's slug resolve at the same
  // domain, so they share one namespace — luot.link/abc can't be both.
  // Two separate unique constraints can't see each other, so nothing
  // currently stops a Link and a QrCode both claiming "abc" on one
  // domain, and the redirect would be ambiguous. Properly fixed by a
  // single table owning the slug namespace that both point at; until
  // then the create paths have to check both tables.
  shortCode String
  label     String

  domainId String
  domain   Domain @relation(fields: [domainId], references: [id])

  linkId String
  link   Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)

  clicks Click[]

  createdAt DateTime @default(now())

  @@unique([domainId, shortCode])
  @@index([linkId])
}

model Click {
  id String @id @default(cuid())

  linkId String
  link   Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)

  // Present only when this hit came through a QR scan rather than a
  // direct link click — this IS what "click vs scan" means, not a
  // separate stored field (which could drift out of sync with the
  // real origin).
  qrCodeId String?
  qrCode   QrCode? @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)

  // Denormalized from Link — this is the highest-volume table in the
  // system, and every analytics query filters by org, so saving that
  // join is worth the small duplication.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Populated at write time (geo-IP lookup, User-Agent parsing) —
  // never derived later
  country  String?
  region   String?
  city     String?
  device   String?
  browser  String?
  referrer String? // source domain, or null for direct

  createdAt DateTime @default(now())

  @@index([linkId, createdAt])
  @@index([organizationId, createdAt])
  @@index([qrCodeId])
}
